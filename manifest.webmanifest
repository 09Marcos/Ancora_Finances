{
  "name": "Caixa · controle financeiro",
  "short_name": "Caixa",
  "description": "Importe extratos do banco e acompanhe saldo e gastos.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EDF0EF",
  "theme_color": "#24508F",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            ".pdf",
            "text/csv",
            "text/comma-separated-values",
            "application/csv",
            ".csv",
            "application/x-ofx",
            "application/ofx",
            "application/vnd.intu.qfx",
            "application/x-qfx",
            ".ofx",
            ".qfx",
            "text/plain",
            ".txt",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}